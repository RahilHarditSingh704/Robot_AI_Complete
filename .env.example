# Copy this file to .env and fill in your own key. Never commit the real .env.
# Loaded by app.py before any other module imports, so anything set here is
# visible to every part of the stack. An environment variable set another way
# (shell profile, systemd EnvironmentFile) always takes priority over this.

GOOGLE_AI_API_KEY=your-google-ai-studio-api-key-here

# --- Ruby: models and voice -------------------------------------------------
# Optional overrides - uncomment to use a non-default model:
# LLM_MODEL=gemini-3.5-flash-lite
# TRANSCRIBE_MODEL=gemini-3.5-flash-lite
# TTS_MODEL=gemini-2.5-flash-preview-tts
# TTS_VOICE=Kore
# TTS_VOICE_ID=gemini

# --- Robot: which way is forward --------------------------------------------
# Only fixable by watching the real robot move - see motion.py's header.
#   mirrored (default) the D-pad's long-standing mapping: motors are mounted
#                      mirror-imaged, so "both motors the same way" spins
#   direct             the ESP32 firmware's own command names, taken literally
# Try the other profile if pressing Forward makes the robot rotate on the spot.
# MOTION_PROFILE=mirrored
# Then, if it moves along the right axis but the wrong way round:
# MOTION_INVERT_DRIVE=1
# MOTION_INVERT_TURN=1

# --- Robot: hardware --------------------------------------------------------
# Follow me turns away from the face instead of toward it (camera mounting /
# mirrored image - unlike MOTION_INVERT_TURN, this affects only follow mode):
# FOLLOW_TURN_INVERT=1

# --- Follow me: tracking feel ------------------------------------------------
# All depend on the robot's turn rate, the camera's field of view and latency,
# and the floor - so they can only be set by watching it track someone.
# How far off-center (+/- fraction of frame width) still counts as centered.
# Raise if the robot fidgets while you stand still:
# FOLLOW_CENTER_DEADZONE=0.15
# After losing the face, keep turning the way they went for this long before
# stopping - usually enough to bring them back into frame on its own. Quantised
# to the detection interval, so it overruns by up to ~0.12s:
# FOLLOW_LOST_COAST_S=0.5
# Below this offset they were centered enough that the exit direction is a
# guess, so stop rather than coast the wrong way:
# FOLLOW_COAST_MIN_OFFSET=0.05
# NOTE: follow-mode SPEED is not set here. It's FOLLOW_DUTY in
# robot_esp32_ble_and_serial/*.ino and needs a reflash - see CLAUDE.md.
# Pin the exact camera rather than probing /dev/video* in order:
# CAMERA_DEVICE=/dev/video0
# CAMERA_WIDTH=1280
# CAMERA_HEIGHT=720
# CAMERA_FPS=30
# CAMERA_STREAM_RESOLUTION=360p
# FACE_MODEL_PATH=models/face_detection_yunet_2023mar.onnx
# Interface whose signal strength the remote page shows:
# WIFI_INTERFACE=wlan0
