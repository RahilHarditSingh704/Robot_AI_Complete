# Copy this file to .env and fill in your own key. Never commit the real .env.
# Loaded by app.py before any other module imports, so anything set here is
# visible to every part of the stack. An environment variable set another way
# (shell profile, systemd EnvironmentFile) always takes priority over this.

GOOGLE_AI_API_KEY=your-google-ai-studio-api-key-here

# --- Ruby: models and voice -------------------------------------------------
# Optional overrides - uncomment to use a non-default model:
# LLM_MODEL=gemini-3.5-flash-lite
# TRANSCRIBE_MODEL=gemini-3.5-flash-lite
# TTS_MODEL=gemini-2.5-flash-preview-tts
# TTS_VOICE=Kore
# TTS_VOICE_ID=gemini

# --- Robot: which way is forward --------------------------------------------
# Only fixable by watching the real robot move - see motion.py's header.
#   mirrored (default) the D-pad's long-standing mapping: motors are mounted
#                      mirror-imaged, so "both motors the same way" spins
#   direct             the ESP32 firmware's own command names, taken literally
# Try the other profile if pressing Forward makes the robot rotate on the spot.
# MOTION_PROFILE=mirrored
# Then, if it moves along the right axis but the wrong way round:
# MOTION_INVERT_DRIVE=1
# MOTION_INVERT_TURN=1

# --- Robot: hardware --------------------------------------------------------
# Follow me turns away from the face instead of toward it (camera mounting /
# mirrored image - unlike MOTION_INVERT_TURN, this affects only follow mode):
# FOLLOW_TURN_INVERT=1
# Follow me (body) backs away from a face that's too far and closes in on one
# that's too near, but the D-pad's Forward is correct - same idea, other axis.
# If Forward is wrong everywhere, use MOTION_INVERT_DRIVE above instead; both
# set at once cancel out in follow mode.
# FOLLOW_DRIVE_INVERT=1

# --- Follow me: tracking feel ------------------------------------------------
# All depend on the robot's turn rate, the camera's field of view and latency,
# and the floor - so they can only be set by watching it track someone.
# How far off-center (+/- fraction of frame width) still counts as centered.
# This is a floor, not the whole answer: follow mode measures how fast it
# actually sweeps a face across the frame and widens the deadzone to whatever
# its own smallest possible turn is, because asking for a correction finer than
# that is what makes a robot pace back and forth instead of settling. Raise if
# it fidgets while you stand still:
# FOLLOW_CENTER_DEADZONE=0.15
# Ceiling on that self-measured widening. Reaching it means the robot swings
# more per decision than any useful deadzone can absorb, and the real fix is a
# lower FOLLOW_DUTY (a reflash - see the NOTE below):
# FOLLOW_TURN_DEADZONE_MAX=0.35
# How far ahead the loop projects the face's movement to decide when to stop
# turning. This is the reaction delay it is compensating for - the camera's
# latency, one loop period, and the wheels' coast down. RAISE IT if the robot
# still swings past people; lower it if it now creeps in from one side in
# visible steps:
# FOLLOW_TURN_LEAD_S=0.28
# How centered that projection has to land before the turn is released:
# FOLLOW_TURN_RELEASE=0.05
# How often the detector runs (plus ~41ms for the detection itself, so 0.06 is
# a ~10Hz loop). Shorter reacts sooner and swings less per decision, at the
# cost of CPU; longer is cheaper but brings back the pacing:
# FOLLOW_DETECT_INTERVAL_S=0.06

# How close follow mode tries to keep you, measured as the face's height over
# the frame's - the fraction is inversely proportional to distance, roughly
# 0.28 at arm's length and 0.20 at a bit over a metre on this camera. Keep the
# ordering FAR_ENTER < FAR_EXIT < CLOSE_EXIT < CLOSE_ENTER; the gap between
# each pair is hysteresis, so a face sitting exactly on a threshold doesn't
# make the robot flip-flop.
# Face smaller than this -> too far, drive forward. RAISE IT if you have to
# walk too far before the robot sets off after you:
# FOLLOW_FAR_ENTER=0.28
# ...and it drives until the face has grown past this:
# FOLLOW_FAR_EXIT=0.36
# Face bigger than this -> too close, back up, until it shrinks past the exit:
# FOLLOW_CLOSE_ENTER=0.50
# FOLLOW_CLOSE_EXIT=0.40
# After losing the face, keep turning the way they went for this long before
# stopping - usually enough to bring them back into frame on its own. Quantised
# to the loop period, so it overruns by up to ~0.1s:
# FOLLOW_LOST_COAST_S=0.5
# Below this offset they were centered enough that the exit direction is a
# guess, so stop rather than coast the wrong way:
# FOLLOW_COAST_MIN_OFFSET=0.05
# NOTE: follow-mode SPEED is not set here. It's FOLLOW_DUTY in
# robot_esp32_ble_and_serial/*.ino and needs a reflash - see CLAUDE.md.

# How far away a face is still found. The detector sees a downscaled copy of
# the frame, and this is the single biggest lever on range - YuNet needs
# roughly 10-20 pixels of face, so halving this halves how far away someone
# can stand. Measured cost per detection on a Pi 5, paid once per loop period:
#   320 -> 7ms    480 -> 23ms    640 -> 41ms (default)    800 -> 68ms
# FOLLOW_DETECT_WIDTH=640
# Detector confidence floor. OpenCV's default of 0.9 throws away exactly the
# faint, small, off-angle detections a distant person produces. Raise toward
# 0.9 if you get false positives, lower for more range:
# FOLLOW_SCORE_THRESHOLD=0.6

# --- Follow me: HEAD mode ----------------------------------------------------
# Head mode pans the servo on GPIO 23 (which carries the camera) and never
# moves the wheels. Set HEAD_INVERT=1 if the head turns away from you rather
# than toward you - which way the angle increases depends on how the servo is
# mounted, and can only be settled by watching it:
# HEAD_INVERT=1
# Neutral angle, and the travel it's allowed. Narrow MIN/MAX if the head hits
# something before reaching the end of the servo's range:
# HEAD_CENTER_DEG=90
# HEAD_MIN_DEG=0
# HEAD_MAX_DEG=180
# Camera's horizontal field of view, used to turn "20% off centre" into
# degrees. Being wrong only scales the loop gain, but closer settles faster:
# HEAD_CAMERA_FOV_DEG=70
# Fraction of the error corrected per detection. Above ~0.8 it starts hunting:
# HEAD_GAIN=0.5
# Head deadzone - tighter than the body's, since a servo has no lash or
# momentum. Raise if the head twitches while you stand still:
# HEAD_DEADZONE=0.06
# NOTE: head SLEW RATE (how fast it sweeps) is SERVO_DEG_PER_S in the .ino,
# not here - the firmware does the smoothing, so it needs a reflash.
# Pin the exact camera rather than probing /dev/video* in order:
# CAMERA_DEVICE=/dev/video0
# CAMERA_WIDTH=1280
# CAMERA_HEIGHT=720
# CAMERA_FPS=30
# CAMERA_STREAM_RESOLUTION=360p
# FACE_MODEL_PATH=models/face_detection_yunet_2023mar.onnx
# Interface whose signal strength the remote page shows:
# WIFI_INTERFACE=wlan0
